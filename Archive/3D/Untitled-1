
// --- Espace EF 3D ---
fespace Vh(ThCylinder, [P2,P2,P2,P1]);

real nu = 1;
real debit = -2.78e-6;
real deltaP = -24*nu*L*debit/(R^3);
real Pe = deltaP/2;
real Ps = -deltaP/2;

func uin = deltaP*z*(R-z)/(4*L);

// Macro
macro grad(w) [dx(w), dy(w), dz(w)] //
macro Grad(wx, wy, wz) [grad(wx), grad(wy), grad(wz)] //
macro div(wx, wy, wz) (dx(wx) + dy(wy) + dz(wz)) //

// Vecteurs solutions & test 
Vh [ux, uy, uz, p], [vx, vy, vz, q];

problem Stokes3D([ux,uy,uz,p], [vx,vy,vz,q]) = int3d(ThCylinder)(nu*((Grad(ux,uy,uz):Grad(vx,vy,vz))) 
                                           - div(vx,vy,vz)*p - div(ux,uy,uz)*q)
                                           + on(10, 20, ux = 0, uy = uin, uz = 0)
					   + on(1, ux = 0, uy = 0, uz = 0);

Stokes3D;
plot(ux, wait = 1);
plot(uy, wait = 1);
plot(uz, wait = 1);
					
